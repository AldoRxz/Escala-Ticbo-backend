# Overrides for running against Supabase instead of the local Docker database.
# Copy to .env.supabase (never committed) and fill the passwords.
#
#   npm run db:migrate:supabase   migrations with the owner role (session pooler)
#   npm run start:supabase        the API on localhost against Supabase
#
# Project ugeephdquoodxhecekof, region us-west-2. Do not put sslmode in the URLs:
# node-postgres would let it override the certificate verification below.

# API: restricted role ticbo_app through the transaction pooler (port 6543)
DATABASE_URL=postgres://ticbo_app.ugeephdquoodxhecekof:<TICBO_APP_PASSWORD>@aws-1-us-west-2.pooler.supabase.com:6543/postgres
# Migrations: owner role through the session pooler (port 5432)
DATABASE_MIGRATION_URL=postgres://postgres.ugeephdquoodxhecekof:<SUPABASE_DB_PASSWORD>@aws-1-us-west-2.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_CA=certs/supabase-root-2021.crt
DATABASE_POOL_MAX=5
