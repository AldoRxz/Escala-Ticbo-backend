# Copy to .env with `npm run setup:env`: it fills the blank secrets below with
# random values. Never commit .env. Production values come from the platform's
# secret manager, not from a file.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# true behind Cloudflare or a load balancer, so req.ip comes from X-Forwarded-For
TRUST_PROXY=false
APP_VERSION=dev

# Public URLs. Canonical domains are served without www.
API_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
# Comma-separated origins allowed by CORS (credentials included)
CORS_ORIGINS=http://localhost:3000

# ── PostgreSQL (docker compose) ────────────────────────────────────────────
POSTGRES_DB=ticbo
POSTGRES_USER=ticbo_owner
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
# Password of "ticbo_app", the restricted role the API connects with (RLS applies)
POSTGRES_APP_PASSWORD=

# postgres://ticbo_app:<POSTGRES_APP_PASSWORD>@localhost:5432/ticbo
DATABASE_URL=
# postgres://ticbo_owner:<POSTGRES_PASSWORD>@localhost:5432/ticbo (migrations only)
DATABASE_MIGRATION_URL=
# Connections per API instance; a pooler multiplexes them in production
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ── Auth ───────────────────────────────────────────────────────────────────
# Random values of at least 32 characters, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
COOKIE_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10

# Argon2id cost (OWASP baseline: 19 MiB of memory, 2 passes, 1 lane)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Google sign-in (optional; leave blank to disable). Authorized redirect URI:
#   {API_PUBLIC_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
