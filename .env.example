# Copy to .env with `npm run setup:env`: it fills the blank secrets below with
# random values. Never commit .env. Production values come from the platform's
# secret manager, not from a file.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# true behind Cloudflare or a load balancer, so req.ip comes from X-Forwarded-For
TRUST_PROXY=false
APP_VERSION=dev

# Public URLs. Canonical domains are served without www.
# Browsers reach the API through the web app's /api proxy (next.config.ts), so
# API_PUBLIC_URL is the web app's origin: cookies and the Google redirect URI
# live there. Production: https://escala-ticbo.vercel.app (GitHub variables).
API_PUBLIC_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000
# Comma-separated origins allowed by CORS (credentials included)
CORS_ORIGINS=http://localhost:3000

# ── PostgreSQL (docker compose) ────────────────────────────────────────────
POSTGRES_DB=ticbo
POSTGRES_USER=ticbo_owner
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
# Password of "ticbo_app", the restricted role the API connects with (RLS applies)
POSTGRES_APP_PASSWORD=

# postgres://ticbo_app:<POSTGRES_APP_PASSWORD>@localhost:5432/ticbo
DATABASE_URL=
# postgres://ticbo_owner:<POSTGRES_PASSWORD>@localhost:5432/ticbo (migrations only)
DATABASE_MIGRATION_URL=
# Connections per API instance; a pooler multiplexes them in production (1 on Lambda)
DATABASE_POOL_MAX=10
# Supabase: DATABASE_SSL=true plus its CA (Database settings → SSL → download
# certificate), as one line with \n between lines. Do not put sslmode in the URLs.
DATABASE_SSL=false
DATABASE_SSL_CA=

# ── Auth ───────────────────────────────────────────────────────────────────
# Random values of at least 32 characters, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
COOKIE_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10

# Argon2id cost (OWASP baseline: 19 MiB of memory, 2 passes, 1 lane)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Google sign-in (optional; leave blank to disable). Authorized redirect URI:
#   {API_PUBLIC_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Vault (customers' secrets) ─────────────────────────────────────────────
# Key-encryption keys as id:base64(32 random bytes), comma-separated. The first
# one encrypts new secrets; keep older ones until secrets are re-wrapped.
#   node -e "console.log('local-v1:' + require('node:crypto').randomBytes(32).toString('base64'))"
VAULT_KEYS=

# ── Files (ticket photos, CFDI XML and PDF) ────────────────────────────────
# S3-compatible bucket: Cloudflare R2 in production
#   endpoint https://<account id>.r2.cloudflarestorage.com, region auto,
#   keys from an R2 API token with Object Read & Write on that bucket only.
# Leave blank in development: files go to OBJECT_STORAGE_DIR.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_DIR=.data/objects

# ── Chat channels ──────────────────────────────────────────────────────────
# Telegram's Bot API; only tests point it elsewhere. Telegram only delivers
# webhooks over https, so a bot connected locally needs a tunnel as API_PUBLIC_URL.
TELEGRAM_API_URL=https://api.telegram.org
